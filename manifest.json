{
  "manifest_version": 3,
  "name": "X 垃圾评论过滤器",
  "version": "0.2.0",
  "description": "自动识别并折叠 X 评论区中的疑似黄推、引流及割韭菜账号回复",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "shared/storage.js",
        "core/rules.js",
        "content/parser.js",
        "content/filter.js",
        "content/actions.js",
        "content/observer.js"
      ],
      "css": ["content/filter.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "X 垃圾评论过滤器"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
